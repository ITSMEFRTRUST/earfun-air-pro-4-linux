#!/usr/bin/env -S python3 -I
"""earfun CLI entry point (works from any cwd, under python -I)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from earfun.cli import main  # noqa: E402

try:
    sys.exit(main())
except BrokenPipeError:
    sys.exit(0)
